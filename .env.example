# Axionvera Network Node Configuration Example
# Copy this file to .env and update with your actual values
# DO NOT commit real secrets or private endpoints to version control

# Network Configuration
# Supported values: local, testnet, mainnet, futurenet
AXIONVERA_NETWORK_NAME=local

# RPC Endpoint Configuration
# Soroban RPC endpoint URL for the target network
# For local development: http://localhost:8000
# For testnet: https://soroban-testnet.stellar.org
# For mainnet: https://soroban-mainnet.stellar.org
AXIONVERA_RPC_URL=http://localhost:8000

# Environment Configuration
# Supported values: development, staging, production
AXIONVERA_ENVIRONMENT=development
